# Copy to .env (project root) and fill in. Never commit the real .env.

# ===================== OPC UA connection =====================
OPC_ENDPOINT_URL=
OPC_USERNAME=
OPC_PASSWORD=

# Client certificate / private key (file names inside CERTS_DIR)
CERTS_DIR=certificates
CLIENT_CERT=
CLIENT_KEY=

# ===================== Application =====================
LOG_LEVEL=WARNING
APP_NAME=Production Dashboard
REFRESH_INTERVAL_MS=1000
SNAPSHOT_INTERVAL_MS=10000
DB_PATH=data.db
