# Copy to .env (project root) and fill in. Never commit the real .env.

# ===================== OPC UA connection =====================
# Tags, screens and alarm/screen nodes are in dashboard.yaml (see docs/CONFIG.md).
# Optional here if opc.url is set in dashboard.yaml; a value here wins.
OPC_ENDPOINT_URL=
# Leave OPC_USERNAME empty for an anonymous session (certificate only; the PLC must allow guest access).
# With OPC_USERNAME set, OPC_PASSWORD is its password (empty if not set).
OPC_USERNAME=
OPC_PASSWORD=

# Client certificate / private key (file names inside CERTS_DIR)
CERTS_DIR=certificates
CLIENT_CERT=
CLIENT_KEY=

# ===================== Web server =====================
# TV view (/), editor (/editor/), API and WebSocket on one port. Plain HTTP, see docs/DRIFT.md.
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
# Built frontend (cd frontend && npm run build). Empty = frontend/dist
FRONTEND_DIST=
# Only with a TLS proxy in front (docs/DRIFT.md): addresses trusted for X-Forwarded-Proto
FORWARDED_ALLOW_IPS=127.0.0.1

# ===================== Application =====================
# Path to the dashboard config (default: dashboard.yaml in the project root)
DASHBOARD_CONFIG=
# auto (default): import dashboard.yaml into the database as a new layout version when the file has changed,
# until the first publish from the editor; always: also after that; off: only on first start (docs/CONFIG.md)
LAYOUT_YAML_IMPORT=auto
LOG_LEVEL=WARNING
APP_NAME=Production Dashboard
REFRESH_INTERVAL_MS=1000
SNAPSHOT_INTERVAL_MS=10000
DB_PATH=data.db
# Days of raw metric history (data_points) to keep; 0 disables cleanup
RETENTION_DAYS=30
RETENTION_CLEANUP_INTERVAL_S=3600
# IANA zone for PLC shift times, e.g. Europe/Stockholm. Empty = system local timezone
TIMEZONE=
# Nominal (ideal) line rate, tiles per minute (OEE performance / targets)
NOMINAL_RATE_TPM=140
OEE_INTERVAL_S=5
# 7-day screen (type: week): refresh interval; past days are cached, only today is recomputed
HISTORY_INTERVAL_S=60
# Shift log: seconds to wait after a shift change (ShiftStart) before the new shift's ShiftTarget/
# OeeTarget/PlannedTime/ShiftTeam are taken; tags may arrive in different OPC frames
SHIFT_SETTLE_S=10
# Highscore screen: stops shorter than this (s) do not end a run; 0 = every stop ends it
HIGHSCORE_MIN_STOP_S=0
